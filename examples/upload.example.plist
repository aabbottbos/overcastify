<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Keeps upload_server.py running (iOS Shortcut uploads into the inbox).
     scripts/install-upload.sh fills in __ROOT__ and loads it. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.overcastify.upload</string>
    <key>ProgramArguments</key>
    <array>
        <string>__ROOT__/venv/bin/python</string>
        <string>__ROOT__/upload_server.py</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>__ROOT__/work/upload.log</string>
    <key>StandardErrorPath</key>
    <string>__ROOT__/work/upload.log</string>
</dict>
</plist>
