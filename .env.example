# Copy to .env (scripts/setup.sh does this for you and generates a token).
# .env is git-ignored. Never commit it.

# Secret part of your feed address. Long and random: docs-<16 hex characters>
FEED_TOKEN=docs-REPLACE_ME

# Where the feed server listens on this machine (localhost only)
HOST_PORT=18080
PORT=8080

# The address Overcast will use. Start with localhost, then set your public https URL
# (see docs/setup.md), e.g. https://my-mac.my-tailnet.ts.net
PUBLIC_BASE_URL=http://localhost:18080

RUN_ON_START=true
PUBLISH_XML=true

# Voice (Kokoro). See docs/configuration.md for the options.
PODCAST_VOICE=af_heart
PODCAST_LANG=a
PODCAST_SPEED=1.0

# MP3 bitrate for YouTube and audio/video files
YT_AUDIO_QUALITY=96K

# Optional: watch a different inbox folder, e.g. one in iCloud Drive so you can
# Share > Save to Files from iPhone. Use a full path in double quotes. Re-run
# scripts/install-launchd.sh after changing it. (docs/ingestion.md)
# PODCAST_INBOX="/Users/YOU/Library/Mobile Documents/com~apple~CloudDocs/Overcastify Inbox"

# Optional: where failed files go (with a .error.txt note), and failure notifications
# PODCAST_FAILED="/Users/YOU/Library/Mobile Documents/com~apple~CloudDocs/Overcastify Inbox/Failed"
# PODCAST_NOTIFY=true

# Optional cleanup. 0 keeps everything.
# PODCAST_KEEP_EPISODES=0
# PODCAST_KEEP_DAYS=0
# PROCESSED_KEEP_DAYS=0

# Upload endpoint for the iOS Shortcut: scripts/install-upload.sh creates UPLOAD_TOKEN
# UPLOAD_MAX_MB=500
